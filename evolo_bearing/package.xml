<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>evolo_bearing</name>
  <version>0.1.0</version>
  <description>Calibrated gimbal yaw correction and bearing-ray visualisation for Evolo.</description>
  <maintainer email="axelholmgren@users.noreply.github.com">Axel Ericson Holmgren</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>yolo_msgs</exec_depend>
  <exec_depend>z1_pro_msgs</exec_depend>
  <exec_depend>evolo_gimbal_calibration</exec_depend>
  <exec_depend>evolo_bearing_error</exec_depend>
  <exec_depend>evolo_reference_markers</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>pointcloud_preprocessing</exec_depend>
  <exec_depend>clustering_segmentation</exec_depend>
  <exec_depend>bb_dataass_tracking</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
